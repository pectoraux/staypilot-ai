// StayPilot AI — Prisma schema (Neon PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("Owner") // Owner | Manager | Receptionist | Marketing Manager | Housekeeping | Admin
  status       String   @default("waitlist") // waitlist | active
  isDemo       Boolean  @default(false)
  property     String   @default("Akwaaba Boutique Lodge")
  createdAt    DateTime @default(now())
  approvedAt   DateTime?
  approvedById String?

  approvals Approval[]
}

model Approval {
  id        String   @id @default(cuid())
  action    String
  taskId    String?
  userId    String?
  status    String   @default("pending") // pending | approved | rejected
  decidedBy String?
  decidedAt DateTime?
  metadata  String? // JSON string
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}
